# Application Settings
APP_NAME=Git_PR_plugin_avito_tech
APP_VERSION=1.0.0
HTTP_PORT=8080

# PostgreSQL Configuration (для Docker Compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=git_pr_plugin
POSTGRES_PORT=5432

# PostgreSQL Configuration (для приложения)
# Формат: postgresql://user:password@host:port/database?sslmode=disable
# Для локального запуска используйте localhost, для Docker - db
PG_URL=postgresql://postgres:your_secure_password@localhost:5432/git_pr_plugin?sslmode=disable
PG_POOL_MAX=10

# Docker Configuration
COMPOSE_PROJECT_NAME=git_pr_plugin

# Logging
LOG_LEVEL=info
